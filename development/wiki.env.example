# Copied to wiki.env by the first development/wiki up; every value is local

# Any branch, tag, commit or pull/N/head
SKIN_REF=main
OOUI_REF=REL1_46

# The first ref is applied whole, then each later ref's changes over it
REMOTE_GADGETS_REFS="main pull/329/head pull/330/head pull/331/head"

# Imported from femiwiki.com with their templates and modules, one request at a time
ARTICLES="페미위키:대문|페미니즘|여성혐오|생리컵|도움말:복붙용 문법표|페미위키:운영팀/개발팀/기술 블로그/18|페미사이드"
EXPORT_INTERVAL=5

# The test account, made by the first development/wiki up, and the installer's
WIKI_USER=LocalTester
WIKI_PASSWORD=local-tester-password
WIKI_ADMIN_PASSWORD=admin_password_please_change
