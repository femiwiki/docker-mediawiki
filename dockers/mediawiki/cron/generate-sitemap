#!/bin/bash

# 검색엔진이 사이트를 더 잘 크롤링하도록 사이트맵을 주기적으로 만든다.
# https://www.mediawiki.org/wiki/Manual:GenerateSitemap.php

set -euo pipefail; IFS=$'\n\t'

cd /srv/femiwiki.com

php maintenance/generateSitemap.php \
  --fspath sitemap \
  --server 'https://femiwiki.com' \
  --urlpath '/sitemap/' \
  --skip-redirects \
  --compress=no

# One line to PID 1's stdout, the container log that reaches Loki, so an alert
# can tell whether a run happened; the rest stays in the cron log file.
# See femiwiki/femiwiki#593.
printf 'generate-sitemap: done, %s files\n' \
  "$(find sitemap -type f | wc -l)" > /proc/1/fd/1
