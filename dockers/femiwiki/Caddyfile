{
	# Global options
	storage s3

	order mwcache before rewrite
	# NOTE: See @filter for the further details
	order respond before rewrite

	# The idle fastcgi port fails its check every second; keep that out of the log
	log default {
		exclude http.handlers.reverse_proxy.health_checker.active
	}
}
femiwiki.com *.femiwiki.com 127.0.0.1:80 localhost:80 {
	tls {
		dns route53
	}
	root * /srv/femiwiki.com
	# Requests that reach php-fpm without a session, per /24. Cache hits never
	# get here, and the login and signup pages set a session cookie on first
	# view, so a room full of people joining an edit-a-thon counts once each.
	# Readers peak at a few a minute; crawlers at 30 and more, all day.
	rate_limit {
		zone dynamic {
			match {
				path /index.php* /api.php*
				not header Cookie *femiwiki*
			}
			key {client_ip}
			ipv4_prefix 24
			ipv6_prefix 64
			events 300
			window 10m
		}
		log_key
	}
	# Static page in the languages of 미디어위키:Loginlanguagelinks; the browser
	# picks one, so nothing here depends on Accept-Language server-side
	handle_errors 429 {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="ko">
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width">
			<title>잠시 후 다시 시도해 주세요</title>
			<style>
			body{font:16px/1.6 sans-serif;max-width:36em;margin:4em auto;padding:0 1em}
			p{display:none}
			html:lang(ko) p:lang(ko),html:lang(en) p:lang(en),html:lang(ja) p:lang(ja),html:lang(fr) p:lang(fr),html:lang(de) p:lang(de),html:lang(es) p:lang(es),html:lang(ru) p:lang(ru){display:block}
			</style>
			<p lang="ko">같은 네트워크에서 짧은 시간에 요청이 많아 잠시 제한되었습니다. 잠시 뒤에 다시 시도해 주세요. 로그인한 상태에서는 제한이 없습니다.</p>
			<p lang="en">Too many requests came from your network in a short time, so access is paused briefly. Please try again in a moment. Logged-in users are not limited.</p>
			<p lang="ja">同じネットワークから短時間に多くのリクエストがあったため、一時的に制限しています。しばらくしてからもう一度お試しください。ログインしていれば制限はありません。</p>
			<p lang="fr">Trop de requêtes sont venues de votre réseau en peu de temps, l'accès est donc suspendu brièvement. Réessayez dans un instant. Les utilisateurs connectés ne sont pas limités.</p>
			<p lang="de">Aus Ihrem Netzwerk kamen in kurzer Zeit zu viele Anfragen, daher ist der Zugriff kurz pausiert. Bitte versuchen Sie es gleich noch einmal. Angemeldete Benutzer sind nicht betroffen.</p>
			<p lang="es">Llegaron demasiadas solicitudes desde su red en poco tiempo, así que el acceso se ha pausado brevemente. Inténtelo de nuevo en un momento. Los usuarios con sesión iniciada no tienen límite.</p>
			<p lang="ru">Из вашей сети за короткое время пришло слишком много запросов, поэтому доступ ненадолго приостановлен. Попробуйте ещё раз через минуту. Для вошедших пользователей ограничений нет.</p>
			<script>
			var titles={ko:"잠시 후 다시 시도해 주세요",en:"Please try again shortly",ja:"しばらくしてからもう一度お試しください",fr:"Réessayez dans un instant",de:"Bitte gleich noch einmal versuchen",es:"Inténtelo de nuevo en un momento",ru:"Попробуйте ещё раз через минуту"};
			for(var i=0,l=navigator.languages||[navigator.language];i<l.length;i++){var c=(l[i]||"").slice(0,2).toLowerCase();if(titles[c]){document.documentElement.lang=c;document.title=titles[c];break}}
			</script>
			HTML 429
	}
	# Two ports so a new fastcgi container can start beside the old one
	php_fastcgi 127.0.0.1:9000 127.0.0.1:9001 {
		lb_policy round_robin
		lb_try_duration 5s
		health_uri /healthz.php
		health_interval 1s
		health_timeout 10s
		health_fails 3
	}
	file_server
	encode gzip
	mwcache {
		ristretto {
			num_counters 10000
			max_cost 1000
			buffer_items 64
		}
		purge_acl {
			10.0.0.0/8
			127.0.0.1
		}
	}
	header {
		# HSTS
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Enable XSS filtering for legacy browsers
		X-XSS-Protection "1; mode=block"
		# Block content sniffing, and enable Cross-Origin Read Blocking
		X-Content-Type-Options "nosniff"
		# Avoid clickjacking
		X-Frame-Options "DENY"
	}
	log {
		format json
	}

	rewrite /w/api.php /api.php
	rewrite /w/* /index.php

	respond /health-check 200

	@block_cidr {
		remote_ip {$BLOCKED_CIDR}
	}

	respond @block_cidr 403 {
		close
	}

	# Ignore malformed requests
	@filter0 {
		path /w/특수:내언어/페미위키:대문
		vars_regexp {query} ^=[0-9]{1,5}$
	}
	@filter1 {
		path /
		vars_regexp {query} ^[A-Z]{5}=[A-Z]{3}$
	}
	@filter2 {
		header User-Agent *ClaudeBot*
	}

	respond @filter0 403 {
		close
	}
	respond @filter1 403 {
		close
	}
	respond @filter2 403 {
		close
	}
}
