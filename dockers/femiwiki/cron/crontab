# The scheduled maintenance, installed by start.sh where jobs run. Each line
# writes to the container's own output, so it reaches the log collector.
31 4 * * * /usr/local/bin/rebuild-property-pairs > /proc/1/fd/1 2>&1
0 18 1 1,7 * /usr/local/bin/publish-dump > /proc/1/fd/1 2>&1
# Temporary accounts end 90 days after they are made
47 4 * * * /usr/local/bin/php /srv/femiwiki.com/maintenance/run.php expireTemporaryAccounts > /proc/1/fd/1 2>&1
