#!/bin/bash
set -euxo pipefail; IFS=$'\n\t'

# Holds no port and never turns healthy, so the apply fails and the generation
# before this one keeps serving until infra replaces this one. See femiwiki/infra#1281.
stay_out_of_service() {
  trap 'exit 0' TERM QUIT
  sleep infinity &
  wait $!
}

# The writable layer survives a restart, and autoheal restarts an unhealthy container
if [ -e /tmp/warm-up-failed ]; then
  echo 'This generation failed its warm-up, so it stays out of service' >&2
  stay_out_of_service
fi

chmod +x /usr/local/bin/prerun
/usr/local/bin/prerun

# shellcheck source=dockers/femiwiki/start.sh
. /usr/local/lib/femiwiki/start.sh
fw_load_secrets

echo 'Starting Femiwiki ...'

# Run Install.php
if [ -z "${MEDIAWIKI_SKIP_INSTALL:-}" ]; then
  echo 'Start installing Mediawiki ...'
  php /srv/femiwiki.com/maintenance/run.php install \
    --lang ko \
    --scriptpath '/w' \
    --dbtype mysql \
    --dbname "${WG_DB_NAME:-femiwiki}" \
    --dbserver "${WG_DB_SERVER}" \
    --dbuser "${WG_DB_USER}" \
    --dbpass "${WG_DB_PASSWORD}" \
    --installdbuser "${WG_DB_USER}" \
    --installdbpass "${WG_DB_PASSWORD}" \
    --pass 'admin_password_please_change' \
    '페미위키' Admin
fi

# Overwrites the LocalSettings.php install.php wrote
fw_install_settings

# Run update script
if [ -z "${MEDIAWIKI_SKIP_UPDATE:-}" ]; then
  php /srv/femiwiki.com/maintenance/run.php update --quick
fi

# ResourceLoader keeps each module's messages in memcached for a week. The
# localisation cache comes built in the image, so nothing else tells it that
# this image's messages changed. Failing to reach memcached must not stop start.
php /srv/femiwiki.com/maintenance/run.php purgeMessageBlobStore || true

# Add Femiwiki to the sites table
if [ -z "${MEDIAWIKI_SKIP_IMPORT_SITES:-}" ]; then
  php /srv/femiwiki.com/maintenance/run.php importSites /etc/mediawiki/site-list.xml
fi

# Production (jobs in jobrunner, #968) and a replica stack set MEDIAWIKI_SKIP_CRON;
# cron then only refreshes the tokens this container's pages need.
if [ -z "${MEDIAWIKI_SKIP_CRON:-}" ]; then
  fw_install_crontab jobs '* * * * * /usr/local/bin/run-jobs > /proc/1/fd/1 2>&1'
  cron
elif [ -n "${SSM_SECRETS:-}" ]; then
  fw_install_crontab tokens
  cron
fi

chmod +x /usr/local/bin/postrun
/usr/local/bin/postrun

# A restart reuses the container's writable layer, so a drain file left behind
# by an earlier SIGTERM survives into the new process. Starting up means this
# container is not draining, and leaving the file would make /healthz.php fail
# forever with nothing to clear it.
rm -f /tmp/draining /tmp/warming

# The status page's port follows PHP_FPM_LISTEN, which infra alternates per
# generation, so the two containers of a deploy never want the same one. The
# http container is told the same number, since Caddy proxies to it.
export PHP_FPM_STATUS_LISTEN=$((PHP_FPM_LISTEN + 200))

# opcache sizes are fixed at module start, so they go in an ini file written
# here from the environment (zz- sorts after opcache-recommended.ini). The #1110
# metrics tell whether a value is right.
cat > /usr/local/etc/php/conf.d/zz-opcache-env.ini <<EOF
opcache.memory_consumption=${PHP_OPCACHE_MEMORY_CONSUMPTION:-128}
opcache.interned_strings_buffer=${PHP_OPCACHE_INTERNED_STRINGS_BUFFER:-32}
opcache.max_accelerated_files=${PHP_OPCACHE_MAX_ACCELERATED_FILES:-4000}
opcache.revalidate_freq=${PHP_OPCACHE_REVALIDATE_FREQ:-60}
EOF

# Warm opcache by asking for a few pages before serving. The drain file goes
# down before php-fpm binds, and warm-up.php lifts it at once if no older
# generation is answering. See femiwiki/femiwiki#567.
case "$PHP_FPM_LISTEN" in
  9000) SIBLING_PORT=9001 ;;
  9001) SIBLING_PORT=9000 ;;
  *) SIBLING_PORT= ;;
esac
if [ -n "$SIBLING_PORT" ]; then
  touch /tmp/warming
fi

# Run php-fpm. On SIGTERM, fail /healthz.php first so Caddy's active health
# check drops this upstream, then let php-fpm finish in-flight requests.
php-fpm &
PHP_FPM_PID=$!
trap 'touch /tmp/draining; sleep 5; kill -QUIT "$PHP_FPM_PID"' TERM

FCGI_WARMUP_URL="127.0.0.1:${PHP_FPM_LISTEN}" \
  FCGI_SIBLING_URL="${SIBLING_PORT:+127.0.0.1:$SIBLING_PORT}" \
  timeout "$(( ${FCGI_WARMUP_SECONDS:-120} + 60 ))" php /usr/local/lib/femiwiki/warm-up.php &
WARM_PID=$!
# Polling rather than waiting: a foreground wait would hold the TERM trap, and
# reaping the warm-up leaves php-fpm's own death invisible to kill -0 below.
while kill -0 "$WARM_PID" 2>/dev/null && kill -0 "$PHP_FPM_PID" 2>/dev/null; do
  sleep 1
done
WARM_STATUS=0
if ! kill -0 "$WARM_PID" 2>/dev/null; then
  wait "$WARM_PID" || WARM_STATUS=$?
fi
rm -f /tmp/warming

# warm-up.php exits 3 when a page kept failing while another generation served
if [ "$WARM_STATUS" -eq 3 ]; then
  touch /tmp/warm-up-failed
  trap - TERM
  kill -QUIT "$PHP_FPM_PID"
  wait "$PHP_FPM_PID" || true
  stay_out_of_service
fi

# php-fpm may have died while the warm-up ran, and a reaped child answers no to
# kill -0 while wait still remembers its status, so ask wait first.
STATUS=0
wait "$PHP_FPM_PID" || STATUS=$?
while kill -0 "$PHP_FPM_PID" 2>/dev/null; do
  wait "$PHP_FPM_PID" && STATUS=0 || STATUS=$?
done
exit "$STATUS"
