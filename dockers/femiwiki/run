#!/bin/bash
set -euxo pipefail; IFS=$'\n\t'

chmod +x /usr/local/bin/prerun
/usr/local/bin/prerun

# Secrets come from SSM Parameter Store in production. Local and CI runs pass
# them as plain env instead and leave SSM_SECRETS unset. Tracing is off for this
# block so the values never reach the container log.
# shellcheck disable=SC2034  # exported by set -a, read by LocalSettings.php
if [ -n "${SSM_SECRETS:-}" ]; then
  set +x -a
  WG_DB_PASSWORD="$(chamber read -q mysql/users/mediawiki password)"
  WG_O_AUTH_2_PRIVATE_KEY="$(chamber read -q mediawiki o_auth_2_private_key)"
  WG_RC_FEEDS_DISCORD_URL="$(chamber read -q mediawiki rc_feeds_discord_url)"
  # Missing means LocalSettings.php keeps the fallback captcha, so start anyway.
  WG_H_CAPTCHA_SECRET_KEY="$(chamber read -q mediawiki/h_captcha secret_key)" || WG_H_CAPTCHA_SECRET_KEY=
  WG_SECRET_KEY="$(chamber read -q mediawiki site_key)"
  WG_SMTP_PASSWORD="$(chamber read -q mediawiki/smtp password)"
  WG_SMTP_USERNAME="$(chamber read -q mediawiki/smtp username)"
  # Missing means BounceHandler keeps its default, so start anyway.
  WG_VERP_SECRET="$(chamber read -q mediawiki verp_secret)" || WG_VERP_SECRET=
  WG_BOUNCE_HANDLER_TOKEN="$(chamber read -q mediawiki/bounce_handler token)" || WG_BOUNCE_HANDLER_TOKEN=
  set +a -x

  # PageViewInfoGA authenticates to Google with an OIDC token for this instance's IAM role
  # (femiwiki/femiwiki#670). Missing only means no view counts, so start anyway; cron retries.
  install -d -o www-data -g www-data -m 0700 /run/secrets
  php /usr/local/lib/femiwiki/google-subject-token.php ||
    echo 'No Google subject token; PageViewInfo shows no view counts until cron gets one' >&2
fi

echo 'Starting Femiwiki ...'

# Run Install.php
if [ -z "${MEDIAWIKI_SKIP_INSTALL:-}" ]; then
  echo 'Start installing Mediawiki ...'
  php /srv/femiwiki.com/maintenance/install.php \
    --lang ko \
    --scriptpath '/w' \
    --dbtype mysql \
    --dbname "${WG_DB_NAME:-femiwiki}" \
    --dbserver "${WG_DB_SERVER}" \
    --dbuser "${WG_DB_USER}" \
    --dbpass "${WG_DB_PASSWORD}" \
    --installdbuser "${WG_DB_USER}" \
    --installdbpass "${WG_DB_PASSWORD}" \
    --pass 'admin_password_please_change' \
    '페미위키' Admin
fi

# Overwrite LocalSettings.php generated by install script
cp -f /etc/mediawiki/LocalSettings.php /srv/femiwiki.com/LocalSettings.php

# LocalSettings.php creates the profile directory if it is missing, and the
# maintenance scripts below and cron run as root, so it would be php-fpm's to
# write only if a request got there first.
if [ -n "${FW_PROFILER:-}" ]; then
  install -d -o www-data -g www-data -m 0750 "${FW_PROFILER_DIR:-/tmp/profiler}"
fi

if [ -n "${MEDIAWIKI_HOTFIX_SNIPPET:-}" ]; then
  cat <<EOF > /etc/mediawiki/Hotfix.php
${MEDIAWIKI_HOTFIX_SNIPPET}
EOF
fi

# Run update script
if [ -z "${MEDIAWIKI_SKIP_UPDATE:-}" ]; then
  /srv/femiwiki.com/maintenance/update.php --quick
fi

# ResourceLoader keeps each module's messages in memcached for a week. The
# localisation cache comes built in the image, so nothing else tells it that
# this image's messages changed. Failing to reach memcached must not stop start.
php /srv/femiwiki.com/maintenance/run.php purgeMessageBlobStore || true

# Add Femiwiki to the sites table
if [ -z "${MEDIAWIKI_SKIP_IMPORT_SITES:-}" ]; then
  php /srv/femiwiki.com/maintenance/importSites.php /etc/mediawiki/site-list.xml
fi

# Cron passes jobs none of this environment, so the crontab sets BASH_ENV (and
# SHELL, since dash ignores it) to a file of the variables the jobs need. See
# femiwiki/femiwiki#588. A stack beside production, on a replica, sets
# MEDIAWIKI_SKIP_CRON because the jobs write.
if [ -z "${MEDIAWIKI_SKIP_CRON:-}" ]; then
  umask 077
  export -p > /etc/femiwiki-cron.env
  {
    echo 'SHELL=/bin/bash'
    echo 'BASH_ENV=/etc/femiwiki-cron.env'
    crontab -l
    # A token lives an hour; PageViewInfoGA reads it at most hourly
    if [ -n "${SSM_SECRETS:-}" ]; then
      echo '*/15 * * * * /usr/local/bin/php /usr/local/lib/femiwiki/google-subject-token.php'
    fi
    # The types LocalSettings keeps off the every-minute runner, a few at a time.
    # Unset means UnlinkedWikibaseFetch; empty means none.
    if [ -n "${FW_JOB_SLOW_TYPES-UnlinkedWikibaseFetch}" ]; then
      for t in $(echo "${FW_JOB_SLOW_TYPES-UnlinkedWikibaseFetch}" | tr ',' ' '); do
        echo "${FW_JOB_SLOW_SCHEDULE:-*/5 * * * *} /usr/local/bin/php /srv/femiwiki.com/maintenance/run.php runJobs --type=$t --maxjobs=${FW_JOB_SLOW_MAXJOBS:-20}"
      done
    fi
  } | crontab -
  umask 022

  # Start cron daemon
  cron
fi

chmod +x /usr/local/bin/postrun
/usr/local/bin/postrun

# A restart reuses the container's writable layer, so a drain file left behind
# by an earlier SIGTERM survives into the new process. Starting up means this
# container is not draining, and leaving the file would make /healthz.php fail
# forever with nothing to clear it.
rm -f /tmp/draining /tmp/warming

# The status page's port follows PHP_FPM_LISTEN, which infra alternates per
# generation, so the two containers of a deploy never want the same one. The
# http container is told the same number, since Caddy proxies to it.
export PHP_FPM_STATUS_LISTEN=$((PHP_FPM_LISTEN + 200))

# opcache sizes are fixed at module start, so they go in an ini file written
# here from the environment (zz- sorts after opcache-recommended.ini). The #1110
# metrics tell whether a value is right.
cat > /usr/local/etc/php/conf.d/zz-opcache-env.ini <<EOF
opcache.memory_consumption=${PHP_OPCACHE_MEMORY_CONSUMPTION:-128}
opcache.interned_strings_buffer=${PHP_OPCACHE_INTERNED_STRINGS_BUFFER:-32}
opcache.max_accelerated_files=${PHP_OPCACHE_MAX_ACCELERATED_FILES:-4000}
opcache.revalidate_freq=${PHP_OPCACHE_REVALIDATE_FREQ:-60}
EOF

# Warm opcache by asking for a few pages before serving. The drain file goes
# down before php-fpm binds, and warm-up.php lifts it at once if no older
# generation is answering. See femiwiki/femiwiki#567.
case "$PHP_FPM_LISTEN" in
  9000) SIBLING_PORT=9001 ;;
  9001) SIBLING_PORT=9000 ;;
  *) SIBLING_PORT= ;;
esac
if [ -n "$SIBLING_PORT" ]; then
  touch /tmp/warming
fi

# Run php-fpm. On SIGTERM, fail /healthz.php first so Caddy's active health
# check drops this upstream, then let php-fpm finish in-flight requests.
php-fpm &
PHP_FPM_PID=$!
trap 'touch /tmp/draining; sleep 5; kill -QUIT "$PHP_FPM_PID"' TERM

FCGI_WARMUP_URL="127.0.0.1:${PHP_FPM_LISTEN}" \
  FCGI_SIBLING_URL="${SIBLING_PORT:+127.0.0.1:$SIBLING_PORT}" \
  timeout "$(( ${FCGI_WARMUP_SECONDS:-120} + 60 ))" php /usr/local/lib/femiwiki/warm-up.php &
WARM_PID=$!
# Polling rather than waiting: a foreground wait would hold the TERM trap, and
# reaping the warm-up leaves php-fpm's own death invisible to kill -0 below.
while kill -0 "$WARM_PID" 2>/dev/null && kill -0 "$PHP_FPM_PID" 2>/dev/null; do
  sleep 1
done
rm -f /tmp/warming

# php-fpm may have died while the warm-up ran, and a reaped child answers no to
# kill -0 while wait still remembers its status, so ask wait first.
STATUS=0
wait "$PHP_FPM_PID" || STATUS=$?
while kill -0 "$PHP_FPM_PID" 2>/dev/null; do
  wait "$PHP_FPM_PID" && STATUS=0 || STATUS=$?
done
exit "$STATUS"
