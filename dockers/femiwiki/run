#!/bin/bash
set -euxo pipefail; IFS=$'\n\t'

chmod +x /usr/local/bin/prerun
/usr/local/bin/prerun

# Secrets come from SSM Parameter Store in production. Local and CI runs pass
# them as plain env instead and leave SSM_SECRETS unset. Tracing is off for this
# block so the values never reach the container log.
# shellcheck disable=SC2034  # exported by set -a, read by LocalSettings.php
if [ -n "${SSM_SECRETS:-}" ]; then
  set +x -a
  WG_DB_PASSWORD="$(chamber read -q mysql/users/mediawiki password)"
  WG_O_AUTH_2_PRIVATE_KEY="$(chamber read -q mediawiki o_auth_2_private_key)"
  WG_RC_FEEDS_DISCORD_URL="$(chamber read -q mediawiki rc_feeds_discord_url)"
  WG_RE_CAPTCHA_SECRET_KEY="$(chamber read -q mediawiki/re_captcha secret_key)"
  WG_SECRET_KEY="$(chamber read -q mediawiki site_key)"
  WG_SMTP_PASSWORD="$(chamber read -q mediawiki/smtp password)"
  WG_SMTP_USERNAME="$(chamber read -q mediawiki/smtp username)"
  set +a -x
fi

echo 'Starting Femiwiki ...'

# Run Install.php
if [ -z "${MEDIAWIKI_SKIP_INSTALL:-}" ]; then
  echo 'Start installing Mediawiki ...'
  php /srv/femiwiki.com/maintenance/install.php \
    --lang ko \
    --scriptpath '/w' \
    --dbtype mysql \
    --dbname femiwiki \
    --dbserver "${WG_DB_SERVER}" \
    --dbuser "${WG_DB_USER}" \
    --dbpass "${WG_DB_PASSWORD}" \
    --installdbuser "${WG_DB_USER}" \
    --installdbpass "${WG_DB_PASSWORD}" \
    --pass 'admin_password_please_change' \
    '페미위키' Admin
fi

# Overwrite LocalSettings.php generated by install script
cp -f /a/LocalSettings.php /srv/femiwiki.com/LocalSettings.php

if [ -n "${MEDIAWIKI_HOTFIX_SNIPPET:-}" ]; then
  cat <<EOF > /a/Hotfix.php
${MEDIAWIKI_HOTFIX_SNIPPET}
EOF
fi

# Run update script
if [ -z "${MEDIAWIKI_SKIP_UPDATE:-}" ]; then
  /srv/femiwiki.com/maintenance/update.php --quick
fi

# Add Femiwiki to the sites table
if [ -z "${MEDIAWIKI_SKIP_IMPORT_SITES:-}" ]; then
  php /srv/femiwiki.com/maintenance/importSites.php /a/site-list.xml
fi

# Start cron daemon
cron

chmod +x /usr/local/bin/postrun
/usr/local/bin/postrun

# A restart reuses the container's writable layer, so a drain file left behind
# by an earlier SIGTERM survives into the new process. Starting up means this
# container is not draining, and leaving the file would make /healthz.php fail
# forever with nothing to clear it.
rm -f /tmp/draining /tmp/warming

# The status page's port follows PHP_FPM_LISTEN, which infra alternates per
# generation, so the two containers of a deploy never want the same one. The
# http container is told the same number, since Caddy proxies to it.
export PHP_FPM_STATUS_LISTEN=$((PHP_FPM_LISTEN + 200))

# opcache reserves its shared memory when the module starts, so these cannot be
# a pool's php_admin_value the way pm.max_children is: they have to be an ini
# file read before PHP comes up. Writing it here means infra can retune the
# cache from the environment, without a php-fpm image and the three bumps that
# follow it. The metrics added by #1110 are what say whether a value is right:
# interned_strings free reaching 0 asks for a larger buffer, and cache_full or
# an oom restart asks for more memory_consumption. zz- sorts after
# opcache-recommended.ini, so these win.
cat > /usr/local/etc/php/conf.d/zz-opcache-env.ini <<EOF
opcache.memory_consumption=${PHP_OPCACHE_MEMORY_CONSUMPTION:-128}
opcache.interned_strings_buffer=${PHP_OPCACHE_INTERNED_STRINGS_BUFFER:-32}
opcache.max_accelerated_files=${PHP_OPCACHE_MAX_ACCELERATED_FILES:-4000}
opcache.revalidate_freq=${PHP_OPCACHE_REVALIDATE_FREQ:-60}
EOF

# An empty opcache costs the first requests a recompile of everything shipped,
# so this container asks itself for a few pages before serving. Refusing helps
# only while the generation before this one still answers, so the file goes
# down before php-fpm binds, and warm-up.php lifts it at once when it finds
# nobody there. See femiwiki/femiwiki#567.
case "$PHP_FPM_LISTEN" in
  9000) SIBLING_PORT=9001 ;;
  9001) SIBLING_PORT=9000 ;;
  *) SIBLING_PORT= ;;
esac
if [ -n "$SIBLING_PORT" ]; then
  touch /tmp/warming
fi

# Run php-fpm. On SIGTERM, fail /healthz.php first so Caddy's active health
# check drops this upstream, then let php-fpm finish in-flight requests.
php-fpm &
PHP_FPM_PID=$!
trap 'touch /tmp/draining; sleep 5; kill -QUIT "$PHP_FPM_PID"' TERM

FCGI_WARMUP_URL="127.0.0.1:${PHP_FPM_LISTEN}" \
  FCGI_SIBLING_URL="${SIBLING_PORT:+127.0.0.1:$SIBLING_PORT}" \
  timeout "$(( ${FCGI_WARMUP_SECONDS:-120} + 60 ))" php /a/warm-up.php &
WARM_PID=$!
# Polling rather than waiting: a foreground wait would hold the TERM trap, and
# reaping the warm-up leaves php-fpm's own death invisible to kill -0 below.
while kill -0 "$WARM_PID" 2>/dev/null && kill -0 "$PHP_FPM_PID" 2>/dev/null; do
  sleep 1
done
rm -f /tmp/warming

# php-fpm may have died while the warm-up ran, and a reaped child answers no to
# kill -0 while wait still remembers its status, so ask wait first.
STATUS=0
wait "$PHP_FPM_PID" || STATUS=$?
while kill -0 "$PHP_FPM_PID" 2>/dev/null; do
  wait "$PHP_FPM_PID" && STATUS=0 || STATUS=$?
done
exit "$STATUS"
